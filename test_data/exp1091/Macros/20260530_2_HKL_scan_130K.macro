 20  50  95 #120
100 105 110
150 200 240
255 260 265
280 340 400 #300
405 410 420
loop i=10, 300 10

set_temp %i
wait 120

preset mcu 10
br 1 0 0.5
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K" 
scan h 0.85 1.15 0.005 k 0 l 0.5 
br 1 0 0.5
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K" 
scan h 1 k 0 l 0.2 0.8 0.02

br 1 0 1.5
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K" 
scan h 0.85 1.15 0.005 k 0 l 1.5
br 1 0 1.5
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K" 
scan h 1 k 0 l 1.2 1.8 0.02

preset mcu 5
br 1 0 0
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K" 
scan h 0.85 1.15 0.005 k 0 l 0
br 0 0 1
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K" 
scan h 0 k 0 l 0.7 1.3 0.02
br 1 0 2
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K" 
scan h 0.85 1.15 0.005 k 0 l 2
br 1 0 2
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K" 
scan h 1 k 0 l 1.7 2.3 0.02

endloop