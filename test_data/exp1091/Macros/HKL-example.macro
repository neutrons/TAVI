br 1 0 1
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K"

 
scan h 0.8 1.2 0.005 k 0 l 1 preset mcu 10


br 1 0 1
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K"

 
scan h 1 k 0 l 0.8 1.2 0.01 preset mcu 10

br 1 0 1
scantitle " (@(h) @(k) @(l)) Longitudinal, T = @(coldtip.position) K"

 
scan h 0.8 1.2 0.005 k 0 l 0.8 1.2 0.005 preset mcu 10