th4th 3 -3 0.3

br 1 1 0.5
scantitle "(@(h) @(k) @(l)) th4th, T = @(coldtip.position) K"
preset mcu 10
th4th 3 -3 0.3

br 1 1 1
scantitle "(@(h) @(k) @(l)) th4th, T = @(coldtip.position) K"
preset mcu 10
th4th 3 -3 0.3

br 1 0 1.5
scantitle "(@(h) @(k) @(l)) th4th, T = @(coldtip.position) K"
preset mcu 10
th4th 3 -3 0.3

br 1 0 2
scantitle "(@(h) @(k) @(l)) th4th, T = @(coldtip.position) K"
preset mcu 10
th4th 3 -3 0.3