br 1 0 0.5
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K" 
scan h 0.7 1.3 0.025 k 0 l 0.5 preset mcu 30

br 1 0 0.5
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K" 
scan h 1 k 0 l 0.2 0.8 0.025 preset mcu 30

br 1 0 1.5
scantitle " (@(h) @(k) @(l)) along H, T = @(coldtip.position) K" 
scan h 0.7 1.3 0.025 k 0 l 1.5 preset mcu 30

br 1 0 1.5
scantitle " (@(h) @(k) @(l)) along L, T = @(coldtip.position) K" 
scan h 1 k 0 l 1.2 1.8 0.025 preset mcu 30
